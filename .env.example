NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_LOGIN_EMAIL=sales@perthcabinetdoors.com.au
NEXT_PUBLIC_ADMIN_LOGIN_EMAIL=sales@perthcabinetdoors.com.au

RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_TO_EMAIL=

NEXT_PUBLIC_SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Customer desk: reading the sales@ mailbox through Microsoft Graph ────────
# One app registration at entra.microsoft.com supplies the first three.
# Needs the APPLICATION permission Mail.Read, with admin consent granted.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=sales@perthcabinetdoors.com.au

# Signs the nightly mailbox read at /api/cron/mail-sync. Vercel sends it as
# an Authorization: Bearer header. Without it the job refuses to run, rather
# than leaving a URL anybody could trigger.
CRON_SECRET=

# ── Website visit tracking ──────────────────────────────────────────────────
# Salts the daily visitor hash written by /api/track, so a stored hash cannot
# be worked back to an address. Any long random string:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Without it the counter still works and still stores no address, but the hash
# becomes guessable by anybody who knows the date and the address, and the
# route says so in the log once per cold start.
#
# Safe to change at any time. The hash already rotates every day, so nothing
# joins a visitor across days either way. See docs/website-visit-tracking.md.
SITE_TRACKING_SALT=
